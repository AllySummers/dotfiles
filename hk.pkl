amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

// Top-level steps implicitly define the `check`, `fix` and `pre-commit` hooks:
//   - check:      runs checks only (no fixes, no staging)
//   - fix:        applies fixes (no staging)
//   - pre-commit: applies fixes, stages them, and stashes unstaged work
steps {
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["deno"] = Builtins.deno
}
